{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "build tp1",
            "command": "g++",
            "args": [
                "-Wall",
                "-Wextra",
                "-g",
                "-o",
                "${workspaceFolder}/a.exe",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/Rationnel.cpp"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
